{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bfi.local/research/falsification/registry.v1.schema.json",
  "title": "BFI paper falsification registry export v1",
  "description": "Site-consumable paper/research falsification book. Not a trading signal. No live orders.",
  "type": "object",
  "required": ["version", "paper_only", "live_orders", "hypotheses"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": "v1" },
    "paper_only": { "const": true },
    "live_orders": { "const": false },
    "updated_at": { "type": "string", "minLength": 1 },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hypothesis" }
    }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "name",
        "freeze_hash",
        "criteria",
        "n",
        "n_target",
        "effect",
        "ci",
        "mde",
        "verdict",
        "holdout"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "freeze_hash": {
          "type": "string",
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "metric", "op", "threshold"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "metric": { "type": "string", "minLength": 1 },
              "op": { "type": "string", "minLength": 1 },
              "threshold": { "type": ["number", "integer"] }
            }
          }
        },
        "n": { "type": ["integer", "null"] },
        "n_target": { "type": "integer" },
        "effect": { "type": ["number", "null"] },
        "ci": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": ["number", "null"] }
        },
        "mde": { "type": ["number", "null"] },
        "verdict": {
          "type": "string",
          "enum": ["FALSIFIED", "PASS", "UNSCORED"]
        },
        "holdout": {
          "type": "object",
          "required": ["start", "end", "timezone"],
          "additionalProperties": true,
          "properties": {
            "start": { "type": ["string", "null"] },
            "end": { "type": ["string", "null"] },
            "timezone": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
