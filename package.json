{
  "name": "bowers-frontier-institute",
  "private": true,
  "version": "1.0.0",
  "description": "Bowers Frontier Institute landing page",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "data:fetch": "node scripts/fetch-core-datasets.mjs",
    "data:normalize": "node scripts/normalize-research-datasets.mjs",
    "data:summarize": "node scripts/generate-market-pulse.mjs",
    "data:refresh": "npm run data:fetch && npm run data:normalize && npm run data:summarize",
    "data:fetch:strict": "node scripts/fetch-core-datasets.mjs --strict",
    "labs:code:init": "node scripts/create-vertical-code-layout.mjs",
    "labs:init": "npm run labs:code:init && npm run labs:storage:init",
    "labs:storage:init": "node scripts/create-lab-storage-layout.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
