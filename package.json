{
  "name": "bowers-frontier-institute",
  "private": true,
  "version": "1.0.0",
  "description": "BR3N premium finance dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run demo:artifacts && vite build",
    "check": "npm run lint && npm test",
    "check:demo-api": "node scripts/check-demo-api.mjs",
    "check:trade": "node scripts/check-trade-framework.mjs",
    "check:collars": "node scripts/check-credit-collars.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:deploy": "npm ci && npm audit --audit-level=high && npm run lint && npm test && npm run check:trade && npm run check:collars && npm run check:pwa && npm run build && GITHUB_PAGES=true npm run build && node scripts/smoke-pages-build.mjs",
    "demo:artifacts": "node scripts/generate-demo-artifacts.mjs",
    "demo:artifacts:check": "node scripts/generate-demo-artifacts.mjs --check",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "replay": "npm run replay:scenarios",
    "replay:reviewed": "node scripts/replay-reviewed.mjs",
    "replay:scenarios": "node scripts/replay-scenarios.mjs",
    "save:chatgpt-handoff": "node scripts/save-chatgpt-handoff.mjs",
    "serve:demo": "node scripts/serve-demo.mjs",
    "preview": "vite preview",
    "quality:dashboard": "node scripts/dashboard_quality.mjs",
    "self-improve:all": "bash scripts/self_improve_all.sh",
    "self-improve:dashboard": "bash scripts/self_improve_dashboard.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
