# BFI Lab OS environment template
# Copy into each lab repo as .env.example, not .env.

BFI_CODE_ROOT=/Volumes/BFI/01_ACTIVE_PROJECTS
BFI_DATA_ROOT=/Volumes/BFI/DATA

# Per-lab examples
BFI_AI_FINANCE_CODE=/Volumes/BFI/01_ACTIVE_PROJECTS/bfi-ai-finance
BFI_AI_FINANCE_DATA=/Volumes/BFI/DATA/bfi-ai-finance
BFI_AI_FINANCE_SQLITE=/Volumes/BFI/DATA/bfi-ai-finance/databases/pilot.sqlite
BFI_AI_FINANCE_DUCKDB=/Volumes/BFI/DATA/bfi-ai-finance/databases/finance_lab.duckdb

BFI_T1D_CODE=/Volumes/BFI/01_ACTIVE_PROJECTS/bfi-t1d
BFI_T1D_DATA=/Volumes/BFI/DATA/bfi-t1d

BR3N_CREATIVE_CODE=/Volumes/BFI/01_ACTIVE_PROJECTS/br3n-creative
BR3N_CREATIVE_DATA=/Volumes/BFI/DATA/br3n-creative

# Optional future object storage. Fill only after provider setup.
BFI_OBJECT_STORAGE_PROVIDER=
BFI_OBJECT_STORAGE_BUCKET_RAW=
BFI_OBJECT_STORAGE_BUCKET_PROCESSED=
BFI_OBJECT_STORAGE_BUCKET_REPORTS=
BFI_OBJECT_STORAGE_BUCKET_ARCHIVES=

# Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
