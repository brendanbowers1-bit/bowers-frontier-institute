# BFI Lab OS environment template
# Copy into each lab repo as .env.example, not .env.

BFI_CODE_ROOT=/Volumes/BFI/01_ACTIVE_PROJECTS
BFI_DATA_ROOT=/Volumes/BFI/DATA

# Per-lab examples
BFI_FINANCE_LAB_CODE=/Volumes/BFI/01_ACTIVE_PROJECTS/bfi-finance-lab
BFI_FINANCE_LAB_DATA=/Volumes/BFI/DATA/bfi-finance-lab
BFI_FINANCE_SQLITE=/Volumes/BFI/DATA/bfi-finance-lab/databases/pilot.sqlite
BFI_FINANCE_DUCKDB=/Volumes/BFI/DATA/bfi-finance-lab/databases/finance_lab.duckdb

# Optional future object storage. Fill only after provider setup.
BFI_OBJECT_STORAGE_PROVIDER=
BFI_OBJECT_STORAGE_BUCKET_RAW=
BFI_OBJECT_STORAGE_BUCKET_PROCESSED=
BFI_OBJECT_STORAGE_BUCKET_REPORTS=
BFI_OBJECT_STORAGE_BUCKET_ARCHIVES=

# Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
