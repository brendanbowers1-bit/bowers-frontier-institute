{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bowers-frontier-institute.local/schemas/research-hypotheses.schema.json",
  "title": "Pinned research hypothesis registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "paperResearchOnly",
    "noTradeExecution",
    "noLiveOrders",
    "noRealFunds",
    "noExchangeApiKeys",
    "noTradingSignals",
    "noLiveFetchAtRuntime",
    "pin",
    "disclaimer",
    "hypotheses"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "paperResearchOnly": { "type": "boolean", "const": true },
    "noTradeExecution": { "type": "boolean", "const": true },
    "noLiveOrders": { "type": "boolean", "const": true },
    "noRealFunds": { "type": "boolean", "const": true },
    "noExchangeApiKeys": { "type": "boolean", "const": true },
    "noTradingSignals": { "type": "boolean", "const": true },
    "noLiveFetchAtRuntime": { "type": "boolean", "const": true },
    "updated": { "type": "string" },
    "pin": { "type": "object" },
    "disclaimer": { "type": "string", "minLength": 20 },
    "hypotheses": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "lab",
          "prUrl",
          "prLabel",
          "status",
          "hypothesis",
          "holdout",
          "n",
          "metrics",
          "verdict"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "lab": { "type": "string", "minLength": 1 },
          "prUrl": { "type": "string", "pattern": "^https://github.com/" },
          "prLabel": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["falsified", "open"] },
          "hypothesis": { "type": "string", "minLength": 1 },
          "holdout": { "type": "string", "minLength": 1 },
          "n": { "type": "number", "exclusiveMinimum": 0 },
          "registrationHash": { "type": ["string", "null"] },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "detail": { "type": "string" }
              }
            }
          },
          "verdict": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
